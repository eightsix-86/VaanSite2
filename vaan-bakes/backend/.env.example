# ============================================================
# Vaan Bakes — environment configuration
# Copy this file to `.env` (git-ignored) for local development.
# On Render/Supabase these are set as environment variables in
# the dashboard — never commit real secrets.
# ============================================================

# PostgreSQL connection string.
# Local dev: leave empty to run with the in-memory catalog fallback.
# Production (free): create a free Postgres database on Supabase and
# paste its "Connection string" (URI mode) here. Example:
#
#   postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
DATABASE_URL=

# Set to "false" for local Postgres without SSL (Supabase uses SSL).
DATABASE_SSL=true

# Port for the Express server.
PORT=4000

# Admin panel password — REQUIRED to enable /admin.html and /api/admin.
# Use a strong, unique value.
ADMIN_PASSWORD=

# Comma-separated list of allowed browser origins for CORS.
# "*" allows any origin (fine for a public catalog API).
# For split hosting, restrict it to your frontend domain, e.g.:
#   https://vaan-bakes.netlify.app,https://yourname.github.io
CORS_ORIGIN=*

# Frontend API base URL (frontend/js/config.js):
# If the frontend is served by the same Express app, leave empty.
# If the frontend is hosted separately (Netlify/GitHub Pages) and the
# API is on Render, set this to your Render URL in config.js, e.g.:
#   https://vaan-bakes-api.onrender.com

